# URL base de la API (View-Internet-Backend), sin barra final.
API_BASE_URL=http://localhost:3000

# Clave para cifrar la cookie de sesión (mínimo 32 caracteres).
# Genérala con: openssl rand -base64 32
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# "enabled" sirve una API simulada (MSW) en /api/mock con los datos del diseño.
# Para usarla: API_BASE_URL=http://localhost:3001/api/mock
API_MOCKING=disabled

# Datos de pago móvil de la sede (los ve el estudiante al reportar su pago).
SEDE_PAGO_MOVIL_BANCO=
SEDE_PAGO_MOVIL_TELEFONO=
SEDE_PAGO_MOVIL_DOCUMENTO=
